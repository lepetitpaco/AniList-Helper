{
  "manifest_version": 3,
  "name": "AniList Helper",
  "version": "1.0.0",
  "description": "Quality-of-life tweaks for AniList: persistent list filters, remembered preferences, bookmarks and quick links. No API calls.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "AniList Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://anilist.co/*"
      ],
      "js": [
        "src/settings.js",
        "src/bridge.js",
        "src/bookmarks.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://anilist.co/*"
      ],
      "js": [
        "src/page/common.js",
        "src/page/filters.js",
        "src/page/preferences.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "anilist-helper@lepetitpaco",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
